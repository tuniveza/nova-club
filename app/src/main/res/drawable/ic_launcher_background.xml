<?xml version="1.0" encoding="utf-8"?>
<!-- Deep space behind the sigil: a purple glow, a few stars, and a planet's horizon lit in gold -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Space: purple near the top-left, sinking to violet-black -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="38"
                android:centerY="30"
                android:gradientRadius="95">
                <item android:offset="0" android:color="#FF4A1A63" />
                <item android:offset="0.45" android:color="#FF1C1129" />
                <item android:offset="1" android:color="#FF06040D" />
            </gradient>
