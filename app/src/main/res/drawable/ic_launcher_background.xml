        </aapt:attr>
    </path>
    <!-- Stars -->
    <path android:fillColor="#E6F3EEFF" android:pathData="M24,26m-0.8,0a0.8,0.8 0,1 1,1.6 0a0.8,0.8 0,1 1,-1.6 0" />
    <path android:fillColor="#99F3EEFF" android:pathData="M33,18m-0.5,0a0.5,0.5 0,1 1,1 0a0.5,0.5 0,1 1,-1 0" />
    <path android:fillColor="#CCFF5FA8" android:pathData="M80,22m-0.7,0a0.7,0.7 0,1 1,1.4 0a0.7,0.7 0,1 1,-1.4 0" />
    <path android:fillColor="#99F3EEFF" android:pathData="M86,44m-0.5,0a0.5,0.5 0,1 1,1 0a0.5,0.5 0,1 1,-1 0" />
    <path android:fillColor="#B3F2D9A0" android:pathData="M22,58m-0.6,0a0.6,0.6 0,1 1,1.2 0a0.6,0.6 0,1 1,-1.2 0" />
