    </path>
    <!-- Magenta nebula, upper right -->
    <path android:pathData="M54,32m-40,0a40,40 0,1 1,80 0a40,40 0,1 1,-80 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="78"
                android:centerY="30"
                android:gradientRadius="40">
                <item android:offset="0" android:color="#55B01D68" />
                <item android:offset="1" android:color="#00B01D68" />
