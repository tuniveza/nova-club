    <path
        android:fillColor="#00000000"
        android:strokeWidth="0.9"
        android:pathData="M0,90.06A150,150 0,0 1,108 90.06">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="0">
                <item android:offset="0" android:color="#22FF5FA8" />
                <item android:offset="0.62" android:color="#FFF2D9A0" />
