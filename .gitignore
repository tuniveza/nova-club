*.jks
*.keystore
*.p12
keystore.properties
signing.properties

# Firebase / Google config (contains API keys); add your own locally
google-services.json

# Android Studio: keep only the shared code style
*.iml
.idea/*
!.idea/codeStyles/
.DS_Store

# Archives and app packages
*.zip
*.apk
*.aab

# Logs
*.log
